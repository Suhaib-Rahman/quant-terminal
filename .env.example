# Backend Configuration
FASTAPI_ENV=development
FASTAPI_DEBUG=True
FASTAPI_LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://quant_user:quant_password@postgres:5432/quant_terminal
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# API Configuration
API_VERSION=v1
API_TITLE=Quant Terminal API
API_DESCRIPTION=Professional financial intelligence platform

# Data Provider Configuration (placeholder)
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Quant Terminal
VITE_APP_VERSION=0.1.0
